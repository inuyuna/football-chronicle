{
  "name": "football-chronicle",
  "private": true,
  "version": "0.41.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:undef": "node scripts/check-undefined.mjs",
    "check": "npm run lint && npm run check:undef && npm run test && npm run build",
    "preview": "vite preview",
    "measure": "vitest run --config vitest.measure.config.js",
    "postinstall": "node scripts/patch-rollup-wasm.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.2",
    "@emnapi/runtime": "^2.0.0-beta.2",
    "@napi-rs/wasm-runtime": "^1.2.6",
    "@rollup/wasm-node": "^4.68.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "oxlint": "^1.92.0",
    "typescript": "~7.0.2",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
